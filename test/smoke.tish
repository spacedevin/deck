import {
  parseProgram,
  tokenize,
  parseScaleRoot,
  normalizeGeneratorId,
  registerGeneratorIdAliases,
  clearGeneratorIdAliases,
  clearGenBlockDialects,
  registerGenBlockDialect,
  parseGenBlock,
  generatorIdToDeck,
  formatTplFloat,
  isKeyword
} from "../src/index.tish"

let failed = 0
fn check(name, cond) {
  if (cond) {
    console.log("ok  - " + name)
  } else {
    failed = failed + 1
    console.log("FAIL - " + name)
  }
}

fn matrixDialect(generatorId, lines) {
  return { kind: "matrixFm", tplHeaderId: generatorId, version: 2, raw: lines, graph: { ops: {} } }
}

clearGeneratorIdAliases()
clearGenBlockDialects()
check("unregistered id passthrough", normalizeGeneratorId("noise_burst") === "noise_burst")
check("parseGenBlock raw dialect-less", parseGenBlock("matrix_fm", ["op 1"]).kind === "matrix_fm")
check("core highlight has scale", isKeyword("scale") === true)
check("core highlight lacks patch dialect", isKeyword("conn") !== true)

registerGeneratorIdAliases({ matrix_fm: "matrixFm" }, { matrixFm: "matrix_fm" })
registerGenBlockDialect(["matrixFm", "matrix_fm"], matrixDialect)
check("registered dialect", parseGenBlock("matrix_fm", ["op 1"]).kind === "matrixFm")
check("registered emit", generatorIdToDeck("matrixFm") === "matrix_fm")

let src = "deck 1\nbpm 128\nscale C major\ntrack kick id c0 gen noise_burst\n  steps x . . .\n"
let parsed = parseProgram(src)
check("parseProgram", parsed !== null && typeof parsed === "object")
check("bpm", parsed.bpm === 128)
check("tokenize", tokenize("bpm 120").length >= 2)
check("parseScaleRoot", parseScaleRoot("C") === 0)
check("formatTplFloat", typeof formatTplFloat(1.5) === "string")

if (failed > 0) {
  console.log(failed + " FAILED")
  process.exit(1)
}
console.log("all passed")
