import { loadProjectFromTpl, emitProject, parseProgram, coDjLineAllowedForSkills } from "../src/index.tish"

let failed = 0
fn check(name, cond) {
  if (cond) {
    console.log("ok  - " + name)
  } else {
    failed = failed + 1
    console.log("FAIL - " + name)
  }
}

let src = "deck 1\nbpm 128\ntrack kick id c0 gen noise_burst\n  steps x . . . x . . . x . . . x . . .\n"
let r = loadProjectFromTpl(src)
if (r.errors && r.errors.length > 0) {
  console.log("errors:", JSON.stringify(r.errors))
}
check("load: no errors", !r.errors || r.errors.length === 0)
check("load: bpm", r.project.bpm === 128)
check("load: one channel", r.project.channels.length === 1)
check("load: channel id", r.project.channels[0].id === "c0")
check("load: steps on", r.project.channels[0].steps[0].on === true)

let out = emitProject(r.project)
check("emit: has deck header", out.indexOf("deck 1") >= 0)
check("emit: has bpm", out.indexOf("bpm 128") >= 0)
check("emit: has track", out.indexOf("track kick") >= 0)

let parsed = parseProgram(src)
check("parseProgram: ok", parsed !== null)

check("skills: bpm needs master", coDjLineAllowedForSkills("bpm 120", ["pattern_steps"]) === false)
check("skills: master allows bpm", coDjLineAllowedForSkills("bpm 120", ["master_mixer"]) === true)
check("skills: steps ok", coDjLineAllowedForSkills("steps x...", ["pattern_steps"]) === true)

if (failed > 0) {
  console.log(failed + " FAILED")
  process.exit(1)
}
console.log("all passed")
