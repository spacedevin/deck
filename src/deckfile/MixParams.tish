import { paramKeyToCamel } from './RegistryMap.tish'

// deck mix param tokens → project field names (channel / actor / master EQ).
export fn mixParamFromTpl(tok) {
  let s = String(tok)
  if (s === "trim") {
    return "gain"
  }
  if (s === "eq_lo") {
    return "eqLo"
  }
  if (s === "eq_mid") {
    return "eqMid"
  }
  if (s === "eq_hi") {
    return "eqHi"
  }
  return paramKeyToCamel(s)
}

export fn mixParamToTpl(camel) {
  if (camel === "eqLo") {
    return "eq_lo"
  }
  if (camel === "eqMid") {
    return "eq_mid"
  }
  if (camel === "eqHi") {
    return "eq_hi"
  }
  return String(camel)
}

export fn isChannelMixParam(p) {
  return p === "gain" || p === "pan" || p === "eqLo" || p === "eqMid" || p === "eqHi"
}

export fn isMasterMixParam(p) {
  return p === "eqLo" || p === "eqMid" || p === "eqHi"
}

export fn isActorMixParam(p) {
  return p === "gain" || p === "eqLo" || p === "eqMid" || p === "eqHi"
}
