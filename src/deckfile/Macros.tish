// Macros — named, parameterized patch templates.
// Built-in catalogs are host-owned; call registerBuiltinMacros(...) at boot.

let hostBuiltins = {}

export fn registerBuiltinMacros(map) {
  hostBuiltins = map ? map : {}
}

export fn clearBuiltinMacros() {
  hostBuiltins = {}
}

/// Built-ins currently registered by the host (empty until registerBuiltinMacros).
export fn builtinMacros() {
  return hostBuiltins
}

/// Resolve a macro by name from user-defined macros first, then host built-ins.
export fn lookupMacro(name, userMacros) {
  if (userMacros && userMacros[name]) {
    return userMacros[name]
  }
  let b = builtinMacros()
  if (b[name]) {
    return b[name]
  }
  return null
}

/// Expand a macro's body into patch lines, substituting $param with override-or-default values.
export fn expandMacroBody(macro, overrides) {
  let vals = {}
  let keys = Object.keys(macro.params)
  let i = 0
  while (i < keys.length) {
    vals[keys[i]] = macro.params[keys[i]]
    i = i + 1
  }
  if (overrides) {
    let ok = Object.keys(overrides)
    let j = 0
    while (j < ok.length) {
      vals[ok[j]] = overrides[ok[j]]
      j = j + 1
    }
  }
  let valKeys = Object.keys(vals)
  let out = []
  let li = 0
  while (li < macro.body.length) {
    let line = macro.body[li]
    let ki = 0
    while (ki < valKeys.length) {
      line = line.split("$" + valKeys[ki]).join(String(vals[valKeys[ki]]))
      ki = ki + 1
    }
    out.push(line)
    li = li + 1
  }
  return out
}
