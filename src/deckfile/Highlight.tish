// Line-level classification for core deck syntax (no dialect / instrument catalogs).
import { tokenize } from './Parser.tish'

let TOP_KEYS = {}
TOP_KEYS["deck"] = true
TOP_KEYS["tpl"] = true
TOP_KEYS["bpm"] = true
TOP_KEYS["launch_quant"] = true
TOP_KEYS["song_seed"] = true
TOP_KEYS["track"] = true
TOP_KEYS["auto"] = true
TOP_KEYS["macro"] = true
TOP_KEYS["song"] = true
TOP_KEYS["follow"] = true
TOP_KEYS["xfade"] = true
TOP_KEYS["main_deck"] = true
TOP_KEYS["swing"] = true
TOP_KEYS["scale"] = true
TOP_KEYS["deck_mix"] = true
TOP_KEYS["remove_track"] = true
TOP_KEYS["session_scenes"] = true
TOP_KEYS["session_slot"] = true
TOP_KEYS["clip"] = true
TOP_KEYS["master_mix"] = true
TOP_KEYS["actor_mix"] = true
TOP_KEYS["end"] = true

// Track / clip body heads that are core language (Apply interprets; gen_block lines stay opaque here).
let BODY_KEYS = {}
BODY_KEYS["mix"] = true
BODY_KEYS["steps"] = true
BODY_KEYS["note"] = true
BODY_KEYS["notes_clear"] = true
BODY_KEYS["adsr"] = true
BODY_KEYS["transpose"] = true
BODY_KEYS["loops"] = true
BODY_KEYS["gen_block"] = true
BODY_KEYS["end"] = true
BODY_KEYS["step_pitch"] = true
BODY_KEYS["step_vel"] = true
BODY_KEYS["step_prob"] = true
BODY_KEYS["step_ratchet"] = true
BODY_KEYS["step_nudge"] = true
BODY_KEYS["voice"] = true
BODY_KEYS["fx"] = true
BODY_KEYS["deck"] = true
BODY_KEYS["gen"] = true

let INLINE_KEYS = {}
INLINE_KEYS["bar"] = true
INLINE_KEYS["v"] = true

fn addHighlightKeys(map, arr) {
  if (!arr) {
    return
  }
  let i = 0
  while (i < arr.length) {
    map[String(arr[i])] = true
    i = i + 1
  }
}

/// Host dialects may add extra keyword sets: { top?: string[], body?: string[], inline?: string[] }
export fn registerHighlightKeywords(extra) {
  if (!extra) {
    return
  }
  addHighlightKeys(TOP_KEYS, extra.top)
  addHighlightKeys(BODY_KEYS, extra.body)
  addHighlightKeys(INLINE_KEYS, extra.inline)
}

export fn isKeyword(s) {
  return TOP_KEYS[s] === true || BODY_KEYS[s] === true
}

export fn isInlineKeyword(s) {
  return INLINE_KEYS[s] === true
}

export fn isStepToken(s) {
  return s === "x" || s === "X" || s === "." || s === "1" || s === "0"
}

export fn classifyLine(line) {
  if (line === null) {
    return { kind: "plain", tokens: [], stepIndices: [] }
  }
  let t = line.trim()
  if (t.length === 0) {
    return { kind: "plain", tokens: [], stepIndices: [] }
  }
  let toks = tokenize(t)
  // tokenize never returns [] for non-empty trimmed text
  let first = toks[0]
  if (first === "steps") {
    let stepIndices = []
    let i = 1
    while (i < toks.length && stepIndices.length < 16) {
      if (isStepToken(toks[i])) {
        stepIndices.push(i)
      }
      i = i + 1
    }
    return { kind: "steps", tokens: toks, stepIndices: stepIndices }
  }
  if (first === "note") {
    return { kind: "note", tokens: toks, stepIndices: [] }
  }
  if (isKeyword(first)) {
    return { kind: "keyword", tokens: toks, stepIndices: [] }
  }
  return { kind: "plain", tokens: toks, stepIndices: [] }
}
