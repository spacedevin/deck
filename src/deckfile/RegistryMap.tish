// Generators / param keys are host-defined. Empty until registered.
//
// Absent-key reads are `null` on every Tish target (interpreter, JS, Rust) — `undefined` is not a
// Tish value, so a lookup miss is tested with `=== null` alone.

let deckToId = {}
let idToDeck = {}
let paramAliases = {}

export fn registerGeneratorIdAliases(forward, emit) {
  if (forward) {
    let keys = Object.keys(forward)
    let i = 0
    while (i < keys.length) {
      let k = keys[i]
      deckToId[String(k)] = forward[k]
      i = i + 1
    }
  }
  if (emit) {
    let ekeys = Object.keys(emit)
    let j = 0
    while (j < ekeys.length) {
      let ek = ekeys[j]
      idToDeck[String(ek)] = emit[ek]
      j = j + 1
    }
  }
}

export fn clearGeneratorIdAliases() {
  deckToId = {}
  idToDeck = {}
}

export fn registerParamKeyAliases(forward) {
  if (!forward) {
    return
  }
  let keys = Object.keys(forward)
  let i = 0
  while (i < keys.length) {
    let k = keys[i]
    paramAliases[String(k)] = forward[k]
    i = i + 1
  }
}

export fn clearParamKeyAliases() {
  paramAliases = {}
}

export fn normalizeGeneratorId(tplId) {
  let s = String(tplId)
  let low = s.toLowerCase()
  if (deckToId[s] !== null) {
    return deckToId[s]
  }
  if (deckToId[low] !== null) {
    return deckToId[low]
  }
  return s
}

export fn generatorIdToDeck(id) {
  let s = String(id)
  if (idToDeck[s] !== null) {
    return idToDeck[s]
  }
  return s
}

export fn snakeToCamel(s) {
  let parts = String(s).split("_")
  let out = parts[0]
  let i = 1
  while (i < parts.length) {
    let p = parts[i]
    if (p.length > 0) {
      out = out + p.charAt(0).toUpperCase() + p.substring(1)
    }
    i = i + 1
  }
  return out
}

export fn camelToSnake(s) {
  let out = ""
  let i = 0
  while (i < String(s).length) {
    let c = String(s).charAt(i)
    if (c >= "A" && c <= "Z") {
      out = out + "_" + c.toLowerCase()
    } else {
      out = out + c
    }
    i = i + 1
  }
  return out
}

export fn paramKeyToCamel(key) {
  let s = String(key)
  if (paramAliases[s] !== null) {
    return paramAliases[s]
  }
  if (s.indexOf("_") >= 0) {
    return snakeToCamel(s)
  }
  return s
}
